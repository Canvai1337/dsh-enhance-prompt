{
  "name": "dsh-enhance-prompt",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "A composer button beside the model selector that rewrites your draft into a clear, sectioned prompt while keeping attached files as chips.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "prompt",
    "composer"
  ],
  "license": "MIT",
  "scripts": {
    "test": "node test/check.mjs && node test/host-http.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "README.md",
    "README.en.md",
    "LICENSE",
    "CHANGELOG.md",
    "examples",
    "test",
    "icon.svg"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}

